# PostgreSQL connection
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sih26135

# JWT - generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Development admin, created/updated by `python seed.py`. Never commit real values.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Uploads (default: backend/uploads)
# UPLOAD_DIR=C:/path/to/uploads
MAX_UPLOAD_MB=5

# Frontend URLs allowed to call the API (comma-separated). Add your Vercel URL in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
